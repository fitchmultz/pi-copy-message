{
  "name": "pi-copy-message",
  "version": "4.0.2",
  "description": "Pi extension with a searchable TUI picker for copying raw session messages",
  "author": "Mitch Fultz (https://github.com/fitchmultz)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "extension",
    "clipboard",
    "copy-message",
    "copy-user",
    "copy",
    "session-messages",
    "slash-command",
    "tui",
    "search",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-copy-message.git"
  },
  "bugs": {
    "url": "https://github.com/fitchmultz/pi-copy-message/issues"
  },
  "homepage": "https://github.com/fitchmultz/pi-copy-message#readme",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:agent": "oxlint --deny-warnings --format=agent .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "policy:check": "node scripts/check-policy.ts",
    "quality:probes": "node --test tests/quality*.test.ts",
    "pack:check": "npm pack --dry-run",
    "check": "npm run policy:check && npm run lint && npm run format:check && npm run typecheck && npm test && npm run pack:check",
    "check:compat": "npm run check",
    "prepublishOnly": "npm run check"
  },
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "24.19.2",
    "oxc-parser": "0.156.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "packageManager": "npm@12.2.0",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
