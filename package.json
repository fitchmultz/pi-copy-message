{
  "name": "pi-copy-message",
  "version": "3.0.0",
  "description": "Pi extension with a searchable TUI picker for copying raw session messages",
  "author": "Mitch Fultz (https://github.com/fitchmultz)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "extension",
    "clipboard",
    "copy-message",
    "copy-user",
    "copy",
    "session-messages",
    "slash-command",
    "tui",
    "search",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-copy-message.git"
  },
  "bugs": {
    "url": "https://github.com/fitchmultz/pi-copy-message/issues"
  },
  "homepage": "https://github.com/fitchmultz/pi-copy-message#readme",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run typecheck && npm pack --dry-run",
    "check:compat": "npm run check",
    "prepublishOnly": "npm run check"
  },
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "24.19.0",
    "typescript": "7.0.2"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "packageManager": "npm@12.1.0",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
